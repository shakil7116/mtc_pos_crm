# Copy this to .env and fill in your values

# PostgreSQL connection string
# Option 1 - Local: postgresql://postgres:password@localhost:5432/mtcpos
# Option 2 - Neon (free cloud): get URL from console.neon.tech
DATABASE_URL=postgresql://postgres:password@localhost:5432/mtcpos

# Optional: Groq API key for voice input parsing
GROQ_API_KEY=

# Optional: Twilio credentials for WhatsApp messaging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
