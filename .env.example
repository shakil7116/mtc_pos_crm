# Copy to .env and fill in. See connections.md for what each one does and what
# breaks without it, and references/first-run.md for setting up a fresh copy from
# nothing — including creating the first admin account.

# ── Required ────────────────────────────────────────────────────────────────

# PostgreSQL. For Supabase use the SESSION POOLER url (…pooler.supabase.com) —
# the direct db.<ref>.supabase.co host is IPv6-only and fails on IPv4 networks.
DATABASE_URL=postgresql://postgres:password@localhost:5432/mtcpos

# Signing secret for login sessions. The server REFUSES TO START without it.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Environment ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5050

# Dev-only auth bypass: lets a request set its own x-user-role header.
# MUST be 0 anywhere real. Also hard-gated on NODE_ENV !== production.
ALLOW_DEV_HEADERS=0

# ── Optional — features degrade gracefully without these ────────────────────

# Voice input parsing + AI Assistant LLM fallback. Without it the Assistant's
# deterministic router still answers the common questions.
GROQ_API_KEY=

# Alternative Assistant LLM backend.
ANTHROPIC_API_KEY=

# WhatsApp / SMS. Without these the app falls back to wa.me deep links.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# OCR for scan-to-inventory IMAGES. CSV, TXT and text-PDF work without any of
# these — only photos and scanned PDFs need a vision model.
#
# OCR_PROVIDER picks one of: anthropic | openai | google | openrouter | custom | groq
# Leave it blank to auto-pick the first one that has a key.
OCR_PROVIDER=
OCR_MODEL=

# Direct vendors
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Routers. OpenRouter is pre-wired:
#   OCR_PROVIDER=openrouter
#   OCR_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_API_KEY=

# ANY other OpenAI-compatible router (OmniRoute, Nara, a self-hosted proxy,
# or one that does not exist yet). Almost all of them use this same format.
#   OCR_PROVIDER=custom
#   OCR_BASE_URL=https://your-router/api/v1
#   OCR_API_KEY=...
#   OCR_MODEL=vendor/model-name
OCR_BASE_URL=
OCR_API_KEY=
